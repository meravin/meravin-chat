# Copy to relay/.env and fill in. relay/.env is gitignored — never commit real values.
# Generate the token with:  openssl rand -hex 32

# --- client auth ---
YOURCHAT_TOKEN=replace-with-a-long-random-string

# --- server ---
HOST=127.0.0.1
PORT=9191
# Comma-separated Origin allowlist for browser clients. Native apps send no Origin
# and are allowed through on the Bearer token alone.
ALLOWED_ORIGINS=

# --- AI A (Claude) ---
AI_A_ADAPTER=claude
ANTHROPIC_API_KEY=
AI_A_MODEL=claude-opus-5
AI_A_NAME=Claude

# --- AI B (OpenAI) ---
AI_B_ADAPTER=openai
OPENAI_API_KEY=
# Must be a model id your account can actually call. If a request comes back
# 404 / "model not found", this is the line to check first.
AI_B_MODEL=gpt-5.6
AI_B_NAME=Codex

# --- home screen ---
# Open-Meteo needs no API key. Leave blank to hide the weather line.
HOME_LAT=
HOME_LON=
